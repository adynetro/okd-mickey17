#!/usr/bin/env bash
# ==============================================================================
# Environment Configuration for OKD Single Node OpenShift (SNO / AIO) - mickey17
# ==============================================================================

# Cluster Identity
export CLUSTER_NAME="mickey17"
export BASE_DOMAIN="engineering.lan"
export CLUSTER_FQDN="${CLUSTER_NAME}.${BASE_DOMAIN}"
export SNO_HOSTNAME="${CLUSTER_NAME}.${BASE_DOMAIN}"

# Proxmox VE & Ceph Cluster Targets (Engineering Cluster: k-cluster)
export PVE_NODE="k1"                                  # Primary target node in k-cluster (k1, k2, or k3)
export PVE_HOST="172.16.0.10"                         # IP or FQDN of Proxmox node
export PVE_USER="root"
export PVE_STORAGE_CEPH_RBD="ceph-rbd"                # Ceph RBD storage pool for VM disk & persistent volumes
export PVE_STORAGE_ISO="cephfs"                       # Storage pool holding installer ISOs (mounted across all nodes)
export PVE_BRIDGE="vmbr0"                             # Network bridge

# Virtual Machine Specifications (Single Node OpenShift / AIO PoC)
export VM_ID="117"                                    # VMID on Proxmox
export VM_NAME="okd-sno-${CLUSTER_NAME}"              # Proxmox VM Display Name
export VM_CPUS="6"                                    # vCPUs assigned to SNO node
export VM_RAM="16384"                                 # RAM in MB (16 GB for PoC, minimum recommended for SNO)
export VM_DISK_SIZE="100G"                            # Disk size on Ceph RBD
export VM_MAC="BC:24:11:17:17:17"                     # Static MAC Address
export VM_IP="172.16.0.17"                            # Static IP assigned to SNO node
export VM_NETMASK="24"                                # CIDR prefix
export VM_GATEWAY="172.16.0.1"                        # Gateway
export VM_DNS="10.0.0.1,172.16.0.1"                   # DNS Resolvers

# Network Subnets for OKD
export MACHINE_CIDR="172.16.0.0/24"
export CLUSTER_CIDR="10.128.0.0/14"
export SERVICE_CIDR="172.30.0.0/16"
export HOST_PREFIX="23"

# OKD SCOS Version & Release Payload
export OKD_VERSION="5.0.0-okd-scos.ec.0"
export OKD_RELEASE_IMAGE="quay.io/okd/scos-release@sha256:8a460cb0a0991b21d87efc994ba28ed54b1d074b6a231125d83bc1a228d19f88"

# Proxmox CSI Plugin Configuration
export CSI_PVE_URL="https://172.16.0.10:8006/api2/json"
export CSI_TOKEN_ID="kubernetes-csi@pve!csi"
export CSI_TOKEN_SECRET="373fe2cb-7742-4a98-8737-0424f7b7e654"
export CSI_REGION="${CLUSTER_NAME}"
export CSI_STORAGE_CLASS="ceph-rbd"

# Paths
export WORKDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export INSTALL_DIR="${WORKDIR}/install-dir"
export ASSETS_DIR="${WORKDIR}/assets"
export SSH_KEY_FILE="${HOME}/.ssh/id_ed25519.pub"
