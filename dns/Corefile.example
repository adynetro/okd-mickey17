# CoreDNS configuration for wildcard *.mickey17.engineering.lan resolution
mickey17.engineering.lan:53 {
    template IN ANY {
        match "^.*\.apps\.mickey17\.engineering\.lan\.$"
        answer "{{ .Name }} 60 IN A 172.16.0.17"
        fallthrough
    }
    hosts {
        172.16.0.17 api.mickey17.engineering.lan
        172.16.0.17 api-int.mickey17.engineering.lan
        172.16.0.17 mickey17.engineering.lan
        fallthrough
    }
    forward . 10.0.0.1 1.1.1.1
    log
    errors
}
